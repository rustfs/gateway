                "kind": "not_configured_error",
                "target": "GetBucketEncryption",
                "summary": "A bucket that never had an encryption document answers 404 with the operation-specific code ServerSideEncryptionConfigurationNotFoundError, not a generic not-found and not an empty 200.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/ErrorResponses.html",
                                "summary": "The error code list documents ServerSideEncryptionConfigurationNotFoundError with HTTP status 404 for a bucket whose server-side encryption configuration was not found."
                              }
                            ],
                "cases": ["c-encryption-0012", "c-encryption-0006"]
              },
