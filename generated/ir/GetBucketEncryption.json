                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_GetBucketEncryption.html",
                                "summary": "The documented response syntax shows Rule elements as direct children of the ServerSideEncryptionConfiguration root with no intermediate wrapper."
                              },
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/264",
                                "summary": "Upstream shipped response roots without the S3 xmlns and strict clients refused them, which is why the root and its namespace are pinned byte for byte."
                              }
                            ],
