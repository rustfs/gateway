              {
                "id": "q-deletes-0027",
                "kind": "result_completeness",
                "target": "DeleteObjects",
                "summary": "Every key in the request appears exactly once in the result, in either the deleted list or the error list, and the two lists together have the same length as the request.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_DeleteObjects.html",
                                "summary": "The result reports the outcome of each key, as either a deleted entry or an error entry."
                              },
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/469",
                                "summary": "Upstream dropped keys it could not delete from the result, so a caller could not tell which of its keys survived."
                              }
                            ],
                "cases": ["c-object-0004", "c-object-0011"]
              }
