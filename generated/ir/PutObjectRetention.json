  "quirks": [
              {
                "id": "q-lock-0004",
                "kind": "xml_root",
                "target": "PutObjectRetention",
                "summary": "The wire root of a retention document is Retention, not the shape name ObjectLockRetention, in both the request and the response; a decoder keyed to the shape name would refuse every real client's document.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutObjectRetention.html",
                                "summary": "The documented request syntax roots the body at a Retention element, while the structure it carries is published as ObjectLockRetention."
                              }
                            ],
                "cases": ["c-lock-0005", "c-lock-0027", "c-lock-0030"]
              },
              {
                "id": "q-lock-0006",
                "kind": "checksum_required",
                "target": "PutObjectLockConfiguration",
                "summary": "All three writes in this family demand an integrity claim on the body, so a request with neither Content-MD5 nor an x-amz-checksum header is refused with 400 before the document is parsed.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutObjectLockConfiguration.html",
                                "summary": "The request documents Content-MD5 as required for the operation, which the pinned model spells as a request checksum requirement shared by the retention and legal-hold writes."
                              }
                            ],
                "cases": ["c-lock-0004", "c-lock-0014"]
              },
              {
                "id": "q-lock-0007",
                "kind": "required_body",
                "target": "PutObjectRetention",
                "summary": "The payload member of all three writes is promoted to required, so an empty body is refused as 400 MalformedXML rather than read as a defaulted document — a silently-accepted empty body is how a legal hold gets set to a value nobody sent.",
                "evidence": [
                              {
                                "kind": "s3s-pr",
                                "ref": "https://github.com/s3s-project/s3s/pull/377",
                                "summary": "Upstream accepted an empty body on the retention and legal-hold writes without an error, and the fix pins the empty-required-XML answer to 400 MalformedXML."
                              }
                            ],
                "cases": ["c-lock-0015"]
              },
              {
                "id": "q-lock-0008",
                "kind": "closed_value_set",
                "target": "DefaultRetention.Mode",
                "summary": "A retention mode outside the documented two-value set — GOVERNANCE, COMPLIANCE, exactly in that spelling — is refused as MalformedXML: the values are case-sensitive, so a lowercase governance is out of the set, and a mode nothing can enforce is a lock that protects nothing.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_ObjectLockRetention.html",
                                "summary": "The Mode member documents the closed value set GOVERNANCE and COMPLIANCE, in upper case, for both the object retention document and the bucket default."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/ErrorResponses.html",
                                "summary": "MalformedXML is documented as the answer for a request body that does not validate against the published schema, which is what an out-of-set enum value is."
                              }
                            ],
                "cases": ["c-lock-0002", "c-lock-0008", "c-lock-0016", "c-lock-0017"]
              },
              {
                "id": "q-lock-0012",
                "kind": "boolean_header",
                "target": "PutObjectRetention.BypassGovernanceRetention",
                "summary": "x-amz-bypass-governance-retention is parsed ASCII-case-insensitively — True and TRUE are true, False is false — and any other value is refused as 400 InvalidArgument, never defaulted: this header is the one switch that weakens GOVERNANCE protection, so an unreadable value must fail closed rather than be guessed true.",
                "evidence": [
                              {
                                "kind": "s3s-pr",
                                "ref": "https://github.com/s3s-project/s3s/pull/151",
                                "summary": "The AWS CLI sends capitalised boolean header values such as True, and a case-sensitive parser refused requests every AWS SDK considers well formed."
                              }
                            ],
                "cases": ["c-lock-0009", "c-lock-0023"]
              },
              {
                "id": "q-lock-0013",
                "kind": "value_constraint",
                "target": "ObjectLockRetention.RetainUntilDate",
                "summary": "A retention write whose RetainUntilDate is not in the future is refused as 400 InvalidArgument: a retain-until instant that has already passed protects nothing, and the comparison is made against an injectable clock so the rule is testable.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/userguide/object-lock.html",
                                "summary": "A retention period protects an object version until a retain-until timestamp ahead of the moment the retention is applied, after which the protection lapses."
                              }
                            ],
                "cases": ["c-lock-0005", "c-lock-0024"]
              },
              {
                "id": "q-lock-0014",
                "kind": "security_unknown_elements",
                "target": "PutObjectLockConfiguration",
                "summary": "Unknown HTTP security-configuration elements are refused before the handler; persisted metadata decoding remains a separate compatibility boundary.",
                "evidence": [
                              {
                                "kind": "other",
                                "ref": "https://github.com/rustfs/gateway/blob/50adc72e/docs/adr/ADR-0007-ext-field-codec.md",
                                "summary": "Security request configuration rejects unknown unregistered fields; persisted reads have a separate policy."
                              },
                              {
                                "kind": "other",
                                "ref": "https://github.com/rustfs/gateway/blob/50adc72e/docs/adr/0018-dialect-vtables-stand-after-adr-0010.md",
                                "summary": "The accepted amendment retains ADR-0007's codec policy while changing only request-carrier layout."
                              }
                            ],
                "cases": ["c-lock-0010"]
              },
              {
                "id": "q-lock-0015",
                "kind": "bucket_state_rule",
                "target": "PutObjectRetention",
                "summary": "A retention or legal-hold write against a bucket that never enabled object lock is refused as 400 InvalidRequest: per-object lock state exists only inside a lock-enabled bucket, so accepting the write would store a protection promise no enforcement path will ever read.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/userguide/object-lock.html",
                                "summary": "Object lock settings can be applied only to objects in buckets that have object lock enabled, which is the configuration state the 400 reports."
                              }
                            ],
                "cases": ["c-lock-0005", "c-lock-0006", "c-lock-0025", "c-lock-0026"]
              }
            ],
