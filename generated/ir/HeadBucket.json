  "quirks": [
              {
                "id": "q-bkt-0009",
                "kind": "body",
                "target": "HeadBucket",
                "summary": "Every HeadBucket response has a zero-length body, including 403 and 404; an error document on a HEAD breaks h2 clients.",
                "evidence": [
                              {
                                "kind": "rfc",
                                "ref": "https://www.rfc-editor.org/rfc/rfc9110#section-9.3.2",
                                "summary": "A HEAD response must not carry content regardless of its status code, which covers the error paths."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_HeadBucket.html",
                                "summary": "The operation is documented as answering status and headers only, with no body on success or error."
                              }
                            ],
                "cases": ["c-bkt-0008", "c-bkt-0025", "c-bkt-0026"]
              },
              {
                "id": "q-bkt-0010",
                "kind": "header",
                "target": "HeadBucket.BucketRegion",
                "summary": "x-amz-bucket-region is mandatory on a HeadBucket success and on the 301 PermanentRedirect; without it SDKs cannot complete the redirect and fail outright.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_HeadBucket.html",
                                "summary": "The response header list carries x-amz-bucket-region, which is what region discovery and redirect handling read."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/ErrorResponses.html",
                                "summary": "PermanentRedirect is the 301 a request reaching the wrong endpoint receives, and the region header is how the client learns the right one."
                              }
                            ],
                "cases": ["c-bkt-0008", "c-bkt-0009", "c-bkt-0011", "c-bkt-0026", "c-bkt-0027", "c-bkt-0033"]
              }
