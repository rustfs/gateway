  "quirks": [
              {
                "id": "q-lock-0005",
                "kind": "xml_root",
                "target": "PutObjectLegalHold",
                "summary": "The wire root of a legal-hold document is LegalHold, not the shape name ObjectLockLegalHold, in both the request and the response.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutObjectLegalHold.html",
                                "summary": "The documented request syntax roots the body at a LegalHold element, while the structure it carries is published as ObjectLockLegalHold."
                              }
                            ],
                "cases": ["c-lock-0006"]
              },
              {
                "id": "q-lock-0006",
                "kind": "checksum_required",
                "target": "PutObjectLockConfiguration",
                "summary": "All three writes in this family demand an integrity claim on the body, so a request with neither Content-MD5 nor an x-amz-checksum header is refused with 400 before the document is parsed.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutObjectLockConfiguration.html",
                                "summary": "The request documents Content-MD5 as required for the operation, which the pinned model spells as a request checksum requirement shared by the retention and legal-hold writes."
                              }
                            ],
                "cases": ["c-lock-0004", "c-lock-0014"]
              },
              {
                "id": "q-lock-0007",
                "kind": "required_body",
                "target": "PutObjectRetention",
                "summary": "The payload member of all three writes is promoted to required, so an empty body is refused as 400 MalformedXML rather than read as a defaulted document — a silently-accepted empty body is how a legal hold gets set to a value nobody sent.",
                "evidence": [
                              {
                                "kind": "s3s-pr",
                                "ref": "https://github.com/s3s-project/s3s/pull/377",
                                "summary": "Upstream accepted an empty body on the retention and legal-hold writes without an error, and the fix pins the empty-required-XML answer to 400 MalformedXML."
                              }
                            ],
                "cases": ["c-lock-0015"]
              },
              {
                "id": "q-lock-0011",
                "kind": "closed_value_set",
                "target": "ObjectLockLegalHold.Status",
                "summary": "A legal-hold status outside the documented two-value set — ON, OFF, exactly in that spelling — is refused as MalformedXML; a lowercase on is out of the set, and an unrecognised status stored today is a hold nobody can lift or trust tomorrow.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_ObjectLockLegalHold.html",
                                "summary": "The Status member documents the closed value set ON and OFF."
                              }
                            ],
                "cases": ["c-lock-0022", "c-lock-0007"]
              },
              {
                "id": "q-lock-0014",
                "kind": "security_unknown_elements",
                "target": "PutObjectLockConfiguration",
                "summary": "Unknown HTTP security-configuration elements are refused before the handler; persisted metadata decoding remains a separate compatibility boundary.",
                "evidence": [
                              {
                                "kind": "other",
                                "ref": "https://github.com/rustfs/gateway/blob/50adc72e/docs/adr/ADR-0007-ext-field-codec.md",
                                "summary": "Security request configuration rejects unknown unregistered fields; persisted reads have a separate policy."
                              },
                              {
                                "kind": "other",
                                "ref": "https://github.com/rustfs/gateway/blob/50adc72e/docs/adr/0018-dialect-vtables-stand-after-adr-0010.md",
                                "summary": "The accepted amendment retains ADR-0007's codec policy while changing only request-carrier layout."
                              }
                            ],
                "cases": ["c-lock-0010"]
              },
              {
                "id": "q-lock-0015",
                "kind": "bucket_state_rule",
                "target": "PutObjectRetention",
                "summary": "A retention or legal-hold write against a bucket that never enabled object lock is refused as 400 InvalidRequest: per-object lock state exists only inside a lock-enabled bucket, so accepting the write would store a protection promise no enforcement path will ever read.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/userguide/object-lock.html",
                                "summary": "Object lock settings can be applied only to objects in buckets that have object lock enabled, which is the configuration state the 400 reports."
                              }
                            ],
                "cases": ["c-lock-0005", "c-lock-0006", "c-lock-0025", "c-lock-0026"]
              }
            ],
