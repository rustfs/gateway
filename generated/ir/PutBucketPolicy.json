  "quirks": [
              {
                "id": "q-pol-0001",
                "kind": "media_type",
                "target": "GetBucketPolicy.Policy",
                "summary": "The bucket policy body is JSON on both the read and the write, the only success body in the S3 surface that is not XML, and the read answers Content-Type application/json with the stored document byte for byte.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_GetBucketPolicy.html",
                                "summary": "The documented response syntax for the policy read is a bare JSON policy document rather than an XML element tree."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutBucketPolicy.html",
                                "summary": "The documented request syntax for the policy write is a bare JSON policy document sent as the whole body."
                              }
                            ],
                "cases": ["c-bucketconfig-0016", "c-bucketconfig-0017", "c-bucketconfig-0057"]
              },
              {
                "id": "q-pol-0006",
                "kind": "checksum_required",
                "target": "PutBucketPolicy",
                "summary": "The policy write demands an integrity claim on the body, so a request with neither Content-MD5 nor an x-amz-checksum header is refused with 400 before an access-control document is read at all.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutBucketPolicy.html",
                                "summary": "The request documents Content-MD5 as the base64 digest of the policy, which the pinned model spells as a request checksum requirement the lowering does not read."
                              }
                            ],
                "cases": ["c-bucketconfig-0039", "c-bucketconfig-0016"]
              },
              {
                "id": "q-pol-0007",
                "kind": "bounded_input",
                "target": "PutBucketPolicy",
                "summary": "A policy is capped at 20 KB and at a nesting depth this parser will follow, both checked before anything interprets the document, and the depth check counts in a loop rather than recursing so that the limit is a refusal instead of a stack overflow.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/userguide/bucket-policies.html",
                                "summary": "The bucket-policy guide states a 20 KB size limit for a bucket policy document."
                              }
                            ],
                "cases": ["c-bucketconfig-0052", "c-bucketconfig-0053"]
              },
              {
                "id": "q-pol-0008",
                "kind": "value_constraint",
                "target": "PutBucketPolicy",
                "summary": "The framework checks that a policy is UTF-8, is syntactically JSON and is an object, and evaluates none of its meaning; the refusal is MalformedPolicy with a constant message that never repeats the document, because a policy names principals and account identifiers.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutBucketPolicy.html",
                                "summary": "The operation documents MalformedPolicy as the error for a policy document the service cannot use, without distinguishing the reason in the code."
                              }
                            ],
                "cases": ["c-bucketconfig-0051", "c-bucketconfig-0054"]
              }
            ],
