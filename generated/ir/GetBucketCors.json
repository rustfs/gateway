                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_GetBucketCors.html",
                                "summary": "The documented response syntax shows CORSRule elements as direct children of the CORSConfiguration root with no intermediate wrapper."
                              },
