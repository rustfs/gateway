  "quirks": [
              {
                "id": "q-encoding-0015",
                "kind": "encoding_type",
                "target": "ListObjectsV2",
                "summary": "When url encoding is requested, a fixed per operation set of members is percent encoded and the encoding type is echoed back; keys containing control characters are otherwise unparseable.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_ListObjectsV2.html",
                                "summary": "Describes the request parameter and states that the response echoes the encoding type when it was requested."
                              },
                              {
                                "kind": "capture",
                                "ref": "captures/list-objects-v2-encoding-url.http",
                                "summary": "Recorded response for a key containing characters that are illegal in XML, showing which members are encoded."
                              }
                            ],
                "cases": ["c-list-0017", "c-list-0023", "c-list-0031", "c-list-0035", "c-list-0036", "c-mpu-0013"]
              },
              {
                "id": "q-flat-0019",
                "kind": "flattened",
                "target": "ListObjectsV2",
                "summary": "Entry and common prefix lists repeat their element with no enclosing wrapper, unlike the wrapped lists used by tag sets and grant lists.",
                "evidence": [
                              {
                                "kind": "smithy-spec",
                                "ref": "https://smithy.io/2.0/spec/protocol-traits.html#xmlflattened-trait",
                                "summary": "Defines the flattened list serialization that removes the wrapper element around repeated members."
                              }
                            ],
                "cases": ["c-list-0003", "c-list-0004", "c-list-0008", "c-list-0038", "c-list-0039", "c-mpu-0012"]
              },
              {
                "id": "q-mpu-upload-0032",
                "kind": "flattened_list",
                "target": "ListMultipartUploads.Uploads",
                "summary": "Each upload element repeats directly under the result root with no wrapper, and the element name is not the member name, so both halves have to come from the model rather than from the member spelling.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_ListMultipartUploads.html",
                                "summary": "The documented response syntax repeats an upload element directly under the result root under a name that differs from the member name."
                              }
                            ],
                "cases": ["c-mpu-0011", "c-mpu-0012", "c-mpu-0013"]
              },
              {
                "id": "q-mpu-upload-id-0037",
                "kind": "capability_token",
                "target": "UploadPart.UploadId",
                "summary": "An upload id is a server-minted capability, not a name the caller chose: it is resolved against the bucket and key of the request before anything is written, an unknown id answers the not-found code, and one belonging to another resource is refused rather than honoured.",
                "evidence": [
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/51",
                                "summary": "Upstream accepted any upload id without checking what it belonged to, so knowing an id was enough to act on somebody else's upload."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_UploadPart.html",
                                "summary": "The request is documented as naming a bucket, a key and an upload id together, and the id is only meaningful for that pair."
                              }
                            ],
                "cases": [
                           "c-mpu-0028",
                           "c-mpu-0029",
                           "c-mpu-0030",
                           "c-mpu-0031",
                           "c-mpu-0032",
                           "c-mpu-0043",
                           "c-mpu-0047",
                           "c-mpu-0049",
                           "c-mpu-0050",
                           "c-mpu-0051",
                           "c-mpu-0052"
                         ]
              },
              {
                "id": "q-mpu-marker-0040",
                "kind": "pagination_cursor",
                "target": "ListParts.NextPartNumberMarker",
                "summary": "A truncated listing hands back a cursor that is valid as the next request's marker, the page-size limit is echoed as the caller sent it rather than as the server clamped it, and a listing of uploads needs both the key cursor and the upload-id cursor because one key can carry several uploads.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_ListMultipartUploads.html",
                                "summary": "Documents the pair of cursors a truncated upload listing returns and how the next request supplies them."
                              },
                              {
                                "kind": "s3s-pr",
                                "ref": "https://github.com/s3s-project/s3s/pull/296",
                                "summary": "Upstream gave the part marker the wrong type and semantics, so a second page could not be requested from the value the first page returned."
                              }
                            ],
                "cases": ["c-mpu-0010", "c-mpu-0011", "c-mpu-0047", "c-mpu-0048"]
              },
              {
                "id": "q-marker-form-0076",
                "kind": "wire_form",
                "target": "ListMultipartUploads.UploadIdMarker",
                "summary": "The upload-id cursor of an upload listing is a server-minted value that comes back through the query string, so one spelling a parent traversal — including the percent-encoded spelling, which is already decoded when the check runs — is refused before the listing reads anything.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_ListMultipartUploads.html",
                                "summary": "The upload-id marker is documented as a value returned by a previous listing, not as a caller-chosen name."
                              },
                              {
                                "kind": "observed",
                                "ref": "https://cwe.mitre.org/data/definitions/22.html",
                                "summary": "Building an index or filesystem path from external input without normalising it is a documented traversal class, and resuming a listing from a marker is the obvious way to reach one."
                              }
                            ],
                "cases": ["c-mpu-0047"]
              }
            ],
