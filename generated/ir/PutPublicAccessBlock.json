  "quirks": [
              {
                "id": "q-pab-0002",
                "kind": "checksum_required",
                "target": "PutPublicAccessBlock",
                "summary": "The public-access write demands an integrity claim on the body, so a request with neither Content-MD5 nor an x-amz-checksum header is refused with 400 before the switches are read.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutPublicAccessBlock.html",
                                "summary": "The request documents Content-MD5 as the base64 digest of the configuration, which the pinned model spells as a request checksum requirement the lowering does not read."
                              }
                            ],
                "cases": ["c-bucketconfig-0040", "c-bucketconfig-0020"]
              },
              {
                "id": "q-pab-0004",
                "kind": "default_value",
                "target": "PublicAccessBlockConfiguration",
                "summary": "All four switches are optional and an omitted one is false, so a document naming two of them turns the other two off rather than leaving them undefined, and the read renders every one of them in lower case.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutPublicAccessBlock.html",
                                "summary": "The request reference declares all four settings as optional booleans, and the read reference beside it shows them rendered in lower case."
                              }
                            ],
                "cases": ["c-bucketconfig-0021", "c-bucketconfig-0055"]
              },
              {
                "id": "q-pab-0005",
                "kind": "security_unknown_elements",
                "target": "PutPublicAccessBlock",
                "summary": "Unknown HTTP public-access settings are refused before the handler; persisted metadata decoding remains separate.",
                "evidence": [
                              {
                                "kind": "other",
                                "ref": "https://github.com/rustfs/gateway/blob/50adc72e/docs/adr/ADR-0007-ext-field-codec.md",
                                "summary": "Security request configuration rejects unknown unregistered fields; persisted reads have a separate policy."
                              },
