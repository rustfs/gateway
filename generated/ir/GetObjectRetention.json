              },
              {
                "id": "q-lock-0004",
                "kind": "xml_root",
                "target": "PutObjectRetention",
                "summary": "The wire root of a retention document is Retention, not the shape name ObjectLockRetention, in both the request and the response; a decoder keyed to the shape name would refuse every real client's document.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutObjectRetention.html",
                                "summary": "The documented request syntax roots the body at a Retention element, while the structure it carries is published as ObjectLockRetention."
                              }
                            ],
