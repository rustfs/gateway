                "kind": "not_configured_error",
                "target": "GetObjectRetention",
                "summary": "An object with no retention answers 404 with the object-level code NoSuchObjectLockConfiguration — a different code from the bucket read's 404, and clients branch on the difference.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/ErrorResponses.html",
                                "summary": "The error code list documents NoSuchObjectLockConfiguration with HTTP status 404 for an object that has no object lock configuration."
                              }
                            ],
