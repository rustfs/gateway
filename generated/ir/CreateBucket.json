  "quirks": [
              {
                "id": "q-bkt-0001",
                "kind": "status",
                "target": "CreateBucket",
                "summary": "A successful bucket creation answers 200, never 201; SDKs and the upstream test suites assert the 200.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_CreateBucket.html",
                                "summary": "The documented success response for a bucket creation is HTTP 200 with no created status."
                              }
                            ],
                "cases": [
                           "c-bkt-0001",
                           "c-bkt-0002",
                           "c-bkt-0005",
                           "c-bkt-0006",
                           "c-bkt-0010",
                           "c-bkt-0011",
                           "c-bkt-0028"
                         ]
              },
              {
                "id": "q-bkt-0002",
                "kind": "header",
                "target": "CreateBucket.Location",
                "summary": "The success response carries a Location header whose value is the path form of the new bucket.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_CreateBucket.html",
                                "summary": "The response syntax lists a Location header naming the bucket that was created."
                              }
                            ],
                "cases": ["c-bkt-0001", "c-bkt-0010"]
              },
              {
                "id": "q-bkt-0003",
                "kind": "region",
                "target": "CreateBucket.LocationConstraint",
                "summary": "us-east-1 is the null constraint and must be omitted; writing it explicitly is a 400 InvalidLocationConstraint.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_CreateBucket.html#API_CreateBucket_RequestBody",
                                "summary": "The request-body documentation states that buckets in us-east-1 do not specify a location constraint."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_BucketLocationConstraint.html",
                                "summary": "us-east-1 is absent from the constraint value list, which is why writing it out is invalid."
                              }
                            ],
                "cases": ["c-bkt-0012", "c-bkt-0013", "c-bkt-0015", "c-bkt-0016", "c-bkt-0017", "c-bkt-0030"]
              },
              {
                "id": "q-bkt-0004",
                "kind": "legacy_alias",
                "target": "CreateBucket.LocationConstraint",
                "summary": "EU is the historical spelling of eu-west-1 and must be accepted in a request constraint, normalised before comparison.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_BucketLocationConstraint.html",
                                "summary": "The enumerated constraint values keep the historical EU alias alongside the modern region names."
                              }
                            ],
                "cases": ["c-bkt-0014"]
              },
              {
                "id": "q-bkt-0005",
                "kind": "status",
                "target": "CreateBucket",
                "summary": "Re-creating a bucket you already own is 200 in us-east-1 for historical reasons and 409 BucketAlreadyOwnedByYou everywhere else.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/ErrorResponses.html",
                                "summary": "The BucketAlreadyOwnedByYou entry states that all regions except us-east-1 answer it and us-east-1 resets the ACL and returns 200."
                              }
                            ],
                "cases": ["c-bkt-0010"]
              },
              {
                "id": "q-bkt-0006",
                "kind": "error_code",
                "target": "CreateBucket",
                "summary": "A name held by another owner is BucketAlreadyExists and a name you hold yourself is BucketAlreadyOwnedByYou; the two 409s must stay distinct.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/ErrorResponses.html",
                                "summary": "The error table lists both conflict codes with different ownership conditions for the same request."
                              }
                            ],
                "cases": ["c-bkt-0010"]
              },
              {
                "id": "q-bkt-0011",
                "kind": "empty_value",
                "target": "CreateBucket.LocationConstraint",
                "summary": "An empty constraint element or empty text is equivalent to omitting the constraint entirely, never an error.",
                "evidence": [
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/229",
                                "summary": "Clients send empty XML elements where they mean an absent field, and the decoder must treat the two alike."
                              },
                              {
                                "kind": "s3s-pr",
                                "ref": "https://github.com/s3s-project/s3s/pull/244",
                                "summary": "Upstream resolved the report by normalising empty elements to the absent field rather than refusing them."
                              }
                            ],
