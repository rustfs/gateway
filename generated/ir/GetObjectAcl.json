  "quirk_refs": ["q-acl-0001", "q-acl-0002", "q-acl-0003", "q-acl-0008"],
  "quirks": [
              {
                "id": "q-acl-0001",
                "kind": "wrapped_list",
                "target": "AccessControlPolicy.Grants",
                "summary": "The grants sit inside an <AccessControlList> wrapper rather than repeating directly under the policy root, which is the opposite of the flattened Contents and Rule lists elsewhere in the surface, and a serializer that flattened them would answer a document every SDK reads as no grants at all.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_GetBucketAcl.html",
                                "summary": "The documented response syntax nests every Grant element inside a single AccessControlList element under the AccessControlPolicy root."
                              }
                            ],
                "cases": ["c-acl-0001", "c-acl-0004", "c-acl-0034"]
              },
              {
                "id": "q-acl-0002",
                "kind": "xml_attribute",
                "target": "Grantee",
                "summary": "The XMLSchema-instance namespace is declared on the <Grantee> element itself rather than on the document root, so a client that resolves prefixes before reading xsi:type finds the declaration where AWS puts it.",
                "evidence": [
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/297",
                                "summary": "Upstream answered ACL documents whose Grantee carried no xsi:type and no namespace declaration, and the Java SDK failed to parse them."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_GetObjectAcl.html",
                                "summary": "The documented response syntax shows the xmlns:xsi declaration written on the Grantee element beside the xsi:type attribute."
                              }
                            ],
                "cases": ["c-acl-0001", "c-acl-0002", "c-acl-0003"]
              },
              {
                "id": "q-acl-0003",
                "kind": "xml_attribute",
                "target": "Grantee.Type",
                "summary": "The grantee discriminator is an XML attribute of <Grantee> and not a child element, which makes it the one member of the supported surface that cannot be written by the ordinary element emitter; the frozen IR reserves xml.attributes for it and the generated encoder writes it from there rather than from a branch in the codec.",
                "evidence": [
                              {
                                "kind": "s3s-pr",
                                "ref": "https://github.com/s3s-project/s3s/pull/299",
                                "summary": "Upstream had to add XML attribute support to its serializer before ACL responses could carry the discriminator at all."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_Grantee.html",
                                "summary": "The Grantee reference documents Type as an attribute of the containing element rather than as a member element."
                              }
                            ],
                "cases": ["c-acl-0001", "c-acl-0002", "c-acl-0003", "c-acl-0004"]
              },
              {
                "id": "q-acl-0004",
                "kind": "aws_deviation",
                "target": "Grantee.Type",
                "summary": "Type is optional in the decoded DTO because the XML reader exposes no attributes; making it required would reject every real Grantee before the runtime can derive its discriminator.",
                "evidence": [
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/297",
                                "summary": "The same missing capability upstream hit from the writing side; here it is the reading side that has no attribute access."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_Grantee.html",
                                "summary": "Each documented Type value pairs with exactly one identifying member, which is what makes the member a sound discriminator."
                              }
                            ],
                "cases": ["c-acl-0005"]
              },
              {
                "id": "q-acl-0008",
                "kind": "not_configured_error",
                "target": "GetBucketAcl",
                "summary": "An ACL is the one bucket subresource that always exists — a bucket nobody configured still has its owner's FULL_CONTROL — so the read answers 200 with the owner grant and there is no operation-specific 404, unlike every other Get/Put subresource triple in the table.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/userguide/acl-overview.html",
                                "summary": "The overview states that every bucket and object carries an ACL from creation, with the resource owner granted full control by default."
                              }
                            ],
                "cases": ["c-acl-0011", "c-acl-0028", "c-acl-0029", "c-acl-0033"]
              },
              {
                "id": "q-acl-0012",
                "kind": "closed_value_set",
                "target": "Grant.Permission",
                "summary": "The five permissions are a closed set and a grant naming anything else is refused rather than stored, which is the one place this family is stricter than its siblings: a stored permission no authorizer can evaluate is a grant that reads as present and enforces as nothing.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/userguide/acl-overview.html#permissions",
                                "summary": "The permissions table enumerates exactly five values and describes what each one grants on a bucket and on an object."
                              }
                            ],
                "cases": ["c-acl-0012", "c-acl-0020"]
              },
              {
                "id": "q-acl-0014",
                "kind": "grantee_discriminator_policy",
                "target": "Grantee.Type",
                "summary": "On the way in the discriminator is derived from whichever of ID, URI or EmailAddress the grantee carries; when the unreadable attribute contradicts those members, the members decide the stored and returned type.",
                "evidence": [
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/297",
                                "summary": "The same missing XML-attribute capability upstream hit from the writing side; here it is the reading side that has no attribute access."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_Grantee.html",
                                "summary": "Each documented Type value pairs with exactly one identifying member, which makes the identifying member a deterministic discriminator."
                              }
                            ],
                "cases": ["c-acl-0005"]
              }
            ],
