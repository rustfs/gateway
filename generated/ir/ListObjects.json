                "cases": ["c-list-0011"]
              },
              {
                "id": "q-encoding-0015",
                "kind": "encoding_type",
                "target": "ListObjectsV2",
                "summary": "When url encoding is requested, a fixed per operation set of members is percent encoded and the encoding type is echoed back; keys containing control characters are otherwise unparseable.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_ListObjectsV2.html",
                                "summary": "Describes the request parameter and states that the response echoes the encoding type when it was requested."
                              },
                              {
                                "kind": "capture",
                                "ref": "captures/list-objects-v2-encoding-url.http",
