  "quirks": [
              {
                "id": "q-root-0013",
                "kind": "root_name",
                "target": "ListObjectsV2",
                "summary": "The response root element is shared verbatim with the first version of the listing operation, so the root name cannot be derived from the operation or output shape name.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_ListObjectsV2.html#API_ListObjectsV2_ResponseSyntax",
