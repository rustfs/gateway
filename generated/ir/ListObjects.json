                "cases": ["c-list-0017", "c-list-0023", "c-list-0031", "c-list-0035", "c-list-0036", "c-mpu-0013"]
              },
              {
                "id": "q-owner-0017",
                "kind": "omit_when",
                "target": "Object.Owner",
                "summary": "Owner information is written only when the request asked for it, so emission depends on a request field rather than on the value itself.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_ListObjectsV2.html",
                                "summary": "States that owner information is returned only when the fetch owner parameter is set."
                              }
                            ],
                "cases": ["c-list-0009", "c-list-0010", "c-list-0024"]
              },
              {
                "id": "q-flat-0019",
                "kind": "flattened",
                "target": "ListObjectsV2",
                "summary": "Entry and common prefix lists repeat their element with no enclosing wrapper, unlike the wrapped lists used by tag sets and grant lists.",
                "evidence": [
                              {
                                "kind": "smithy-spec",
                                "ref": "https://smithy.io/2.0/spec/protocol-traits.html#xmlflattened-trait",
                                "summary": "Defines the flattened list serialization that removes the wrapper element around repeated members."
                              }
                            ],
                "cases": ["c-list-0003", "c-list-0004", "c-list-0008", "c-list-0038", "c-list-0039", "c-mpu-0012"]
              },
              {
                "id": "q-etag-0020",
                "kind": "etag_render",
                "target": "Object.ETag",
                "summary": "Inside the listing body the entity tag keeps its surrounding quotes, in contrast with the bare form used by the object attributes operation.",
                "evidence": [
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/632",
                                "summary": "Upstream applied one quoting rule everywhere, which is wrong for one of the two body contexts."
                              }
                            ],
                "cases": ["c-list-0021"]
              },
              {
                "id": "q-storageclass-0022",
                "kind": "omit_when",
                "target": "Object.StorageClass",
                "summary": "The storage class element in a listing is always written including the default class, which is the opposite of the header form that is suppressed for the default class.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_ListObjectsV2.html",
                                "summary": "The documented listing response includes the storage class element for every entry."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_GetObject.html",
                                "summary": "States that the storage class response header is returned for every object except those in the default class."
                              }
                            ],
                "cases": ["c-list-0018", "c-list-0019", "c-object-0012"]
              },
              {
                "id": "q-empty-0063",
                "kind": "empty_value",
                "target": "ListObjects",
                "summary": "The first listing version writes both its prefix and its marker element even when neither was supplied, so an absent value is an empty element rather than no element.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_ListObjects.html",
                                "summary": "The documented response syntax carries both elements unconditionally."
                              },
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/229",
                                "summary": "Upstream treated an empty element and an absent element as different values, which breaks in both directions."
                              }
                            ],
                "cases": ["c-list-0002", "c-list-0003", "c-list-0018", "c-list-0022"]
              },
              {
                "id": "q-marker-0064",
                "kind": "computed_member",
                "target": "ListObjects.NextMarker",
                "summary": "The first listing version emits its next cursor only when the page was truncated, and must emit it when a delimiter is in play because the client cannot derive it from the last entry.",
                "evidence": [
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/544",
                                "summary": "Upstream truncated a delimited listing without emitting the next cursor, leaving the client no way to ask for page two."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_ListObjects.html",
                                "summary": "States the next cursor is present when the result was truncated and describes its role when a delimiter groups keys."
                              }
                            ],
                "cases": ["c-list-0002", "c-list-0041", "c-list-0042"]
              },
              {
                "id": "q-owner-0065",
                "kind": "omit_when",
                "target": "ListObjects.Object.Owner",
                "summary": "The first listing version has no fetch owner parameter and writes owner information for every entry, so the suppression the entry shape carries applies to the second version alone.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_ListObjects.html",
                                "summary": "The documented response carries owner information for every entry and the request has no parameter that would suppress it."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_ListObjectsV2.html",
                                "summary": "States that the second version returns owner information only when the request asked for it."
                              }
                            ],
                "cases": ["c-list-0010", "c-list-0024"]
              },
              {
                "id": "q-order-0066",
                "kind": "element_order",
                "target": "ListObjects",
                "summary": "Sibling order is a wire contract in every listing of this family and inside the version entry as well; the bucket name and the cursors precede the entry list.",
                "evidence": [
                              {
                                "kind": "s3s-pr",
                                "ref": "https://github.com/s3s-project/s3s/pull/480",
                                "summary": "Upstream emitted listing elements in model order and broke a strict client until the order was corrected."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_ListObjects.html",
                                "summary": "The documented response syntax fixes the sibling order the golden comparison pins."
                              }
                            ],
                "cases": ["c-list-0015", "c-list-0018", "c-list-0022"]
              },
              {
                "id": "q-encoding-0067",
                "kind": "encoding_type",
                "target": "ListObjects",
                "summary": "The set of members percent encoded under url encoding is defined per operation, so the first version encodes its marker pair and the version listing encodes its key marker pair instead.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_ListObjects.html",
                                "summary": "Names the members the first listing version encodes and states that the encoding type is echoed back."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_ListObjectVersions.html",
                                "summary": "Names a different member set for the version listing, including its key marker pair."
                              }
                            ],
                "cases": ["c-list-0017", "c-list-0035"]
              },
              {
                "id": "q-maxkeys-0068",
