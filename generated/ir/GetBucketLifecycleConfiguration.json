  "quirks": [
              {
                "id": "q-lc-0001",
                "kind": "not_configured_error",
                "target": "GetBucketLifecycleConfiguration",
                "summary": "A bucket that never had a lifecycle document answers 404 with the operation-specific code NoSuchLifecycleConfiguration, not a generic not-found and not an empty 200.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_GetBucketLifecycleConfiguration.html",
                                "summary": "The operation's error table lists NoSuchLifecycleConfiguration with HTTP status 404 for a bucket without a lifecycle configuration."
                              }
                            ],
                "cases": ["c-lifecycle-0013", "c-lifecycle-0011"]
              },
              {
                "id": "q-lc-0003",
                "kind": "flattened_list",
                "target": "BucketLifecycleConfiguration.Rules",
                "summary": "The rules repeat as sibling Rule elements directly under the LifecycleConfiguration root; a Rules wrapper element would make every SDK read zero rules.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_GetBucketLifecycleConfiguration.html",
                                "summary": "The documented response syntax shows Rule elements as direct children of the LifecycleConfiguration root with no intermediate wrapper."
                              },
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/264",
                                "summary": "Upstream shipped response roots without the S3 xmlns and strict clients refused them, which is why the root and its namespace are pinned byte for byte."
                              }
                            ],
                "cases": ["c-lifecycle-0002", "c-lifecycle-0003", "c-lifecycle-0006"]
              }
            ],
