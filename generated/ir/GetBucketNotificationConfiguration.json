  "quirks": [
              {
                "id": "q-ntf-0001",
                "kind": "not_configured_error",
                "target": "GetBucketNotificationConfiguration",
                "summary": "A bucket that delivers no events answers 200 with an empty NotificationConfiguration element rather than a 404, so a client reads no subscriptions rather than a missing resource.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_GetBucketNotificationConfiguration.html",
                                "summary": "The operation documents an empty configuration element as the response for a bucket with no notifications and lists no not-found error for it."
                              },
                              {
                                "kind": "s3s-pr",
                                "ref": "https://github.com/s3s-project/s3s/pull/193",
                                "summary": "Upstream had to correct the shape of this response, and the empty-configuration case was part of what was wrong."
                              }
                            ],
                "cases": ["c-bucketconfig-0024", "c-bucketconfig-0011"]
              },
              {
                "id": "q-ntf-0002",
                "kind": "flattened_list",
                "target": "NotificationConfiguration",
                "summary": "All three destination lists and the Event list inside each of them repeat as sibling elements directly under their parent with no wrapper, which is the opposite of the website family's wrapped routing rules.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutBucketNotificationConfiguration.html",
                                "summary": "The documented request syntax shows the topic, queue and function configurations as direct children of the root with no intermediate element, and the event names likewise inside each of them."
                              }
                            ],
                "cases": ["c-bucketconfig-0011", "c-bucketconfig-0010"]
              }
            ],
