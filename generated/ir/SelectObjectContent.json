  "quirks": [
              {
                "id": "q-select-0001",
                "kind": "route_predicate",
                "target": "SelectObjectContent",
                "summary": "select-type=2 is half of the operation's route predicate and not decoration: the value names the version of the request grammar, so a request that omits it or sends any other value reaches no select row at all rather than being decoded by a version that has never validated it.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_SelectObjectContent.html",
                                "summary": "The operation is addressed as POST on the object key with the query select and select-type set to 2, and the pinned model spells both into its http uri."
                              }
                            ],
                "cases": ["c-select-restore-0020", "c-select-restore-0021"]
              },
              {
                "id": "q-select-0002",
                "kind": "value_constraint",
                "target": "SelectObjectContent.Expression",
                "summary": "The expression is opaque to this crate — never parsed, never logged, never repeated into an error — and bounded at the documented 256 KiB, past which the request is refused 400 ExpressionTooLong before anything reads the text.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_SelectObjectContent.html",
                                "summary": "The Expression member documents a maximum length of 256 KB and the operation publishes ExpressionTooLong as the answer for exceeding it."
                              }
                            ],
                "cases": ["c-select-restore-0022", "c-select-restore-0023"]
              },
              {
                "id": "q-select-0003",
                "kind": "exclusive_members",
                "target": "SelectObjectContent.InputSerialization",
                "summary": "An InputSerialization names exactly one of CSV, JSON and Parquet: two of them together is 400 ObjectSerializationConflict, and none of them is 400 MalformedXML, because a reader that picked one of two declared formats would parse the object as something the caller did not describe.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_InputSerialization.html",
                                "summary": "The structure documents CSV, JSON and Parquet as alternative descriptions of one object's format, and the operation publishes ObjectSerializationConflict for a request that names more than one."
                              }
                            ],
                "cases": ["c-select-restore-0024", "c-select-restore-0025"]
              },
              {
                "id": "q-select-0004",
                "kind": "exclusive_members",
                "target": "SelectObjectContent.OutputSerialization",
                "summary": "An OutputSerialization names exactly one of CSV and JSON, on the same rule as the input side: both together is 400 ObjectSerializationConflict and neither is 400 MalformedXML.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_OutputSerialization.html",
                                "summary": "The structure documents CSV and JSON as alternative descriptions of how records are returned, one per request."
                              }
                            ],
                "cases": ["c-select-restore-0026", "c-select-restore-0027"]
              },
              {
                "id": "q-select-0005",
                "kind": "exclusive_members",
                "target": "SelectObjectContent.ScanRange",
                "summary": "A ScanRange has two members and three documented forms — both bounds, a Start alone running to the end, an End alone meaning the suffix — so an element with neither bound is refused rather than read as the whole object, and so is an End below a Start or a negative bound: each of those names no window or two.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_ScanRange.html",
                                "summary": "The structure documents Start and End as a byte window and describes the forms in which one of the two may be omitted, with the suffix form spelled as an End with no Start."
                              }
                            ],
                "cases": ["c-select-restore-0008", "c-select-restore-0028", "c-select-restore-0029"]
              },
              {
                "id": "q-select-0006",
                "kind": "closed_value_set",
                "target": "SelectObjectContent.ExpressionType",
                "summary": "ExpressionType has exactly one documented value, SQL, and a request naming any other is 400 InvalidExpressionType; CompressionType is likewise closed at NONE, GZIP and BZIP2, refused as 400 InvalidCompressionFormat, because a compression this side cannot name is a stream nobody can read.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_SelectObjectContent.html",
                                "summary": "The operation documents SQL as the only expression type and publishes InvalidExpressionType and InvalidCompressionFormat as the answers for the two closed sets."
                              }
                            ],
                "cases": ["c-select-restore-0030", "c-select-restore-0031"]
              },
              {
                "id": "q-select-0007",
                "kind": "lenient_unknown_elements",
                "target": "SelectObjectContent",
                "summary": "Unknown elements inside a SelectObjectContentRequest are skipped and a namespace on the root is ignored, the same leniency every other request document in this tree is decoded with.",
                "evidence": [
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/613",
                                "summary": "AWS ignores unknown elements in request XML, and upstream had to relax its decoder to match after strict parsing broke real clients."
                              }
                            ],
                "cases": ["c-select-restore-0009"]
              },
              {
                "id": "q-select-0008",
                "kind": "xml_root",
                "target": "SelectObjectContent",
                "summary": "This is the only request in the supported surface whose XML members sit at operation level rather than inside a payload structure, so the body root is the input shape's own name, SelectObjectContentRequest, and a body rooted at anything else is 400 MalformedXML.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_SelectObjectContent.html",
                                "summary": "The documented request syntax roots the body at a SelectObjectContentRequest element carrying the expression and the serialization descriptions directly."
                              }
                            ],
                "cases": ["c-select-restore-0032", "c-select-restore-0033", "c-select-restore-0034"]
              },
              {
                "id": "q-select-0009",
                "kind": "deferred_response",
                "target": "SelectObjectContent",
                "summary": "The response half is deliberately absent, and what is absent is only the plumbing: the framing — two CRC-32s over two different ranges, one covering the eight prelude bytes alone and one covering every byte of the message but itself — is implemented and proved byte for byte against independently computed values, while the third response shape a stream needs is not this family's to add, so a well-formed query is told NotImplemented rather than answered a bare 200.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/RESTSelectObjectAppendix.html",
                                "summary": "The response is a sequence of self-framed messages, each a prelude with its own CRC, a header block, a payload and a message CRC, rather than one document."
                              },
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/350",
                                "summary": "Upstream shipped responses that ended without completing, which hangs a client — the failure a partly-wired stream produces and a refusal does not."
                              },
                              {
                                "kind": "rfc",
                                "ref": "https://www.rfc-editor.org/rfc/rfc1952#section-8",
                                "summary": "The framing digest is CRC-32/ISO-HDLC, whose published check value over the nine ASCII digits is what pins this implementation to the same parameterisation as everybody else's."
                              }
                            ],
                "cases": ["c-select-restore-0035"]
              },
              {
                "id": "q-sse-0010",
                "kind": "secret_hygiene",
                "target": "PutObject",
                "summary": "The customer key is never echoed back and never logged, while the algorithm and key digest must be echoed; customer keys over a plaintext connection are refused.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/dev/ServerSideEncryptionCustomerKeys.html",
                                "summary": "Requires a secure connection for customer provided keys and describes which of the three headers are echoed in the response."
                              }
                            ],
                "cases": ["c-ssec-0001", "c-ssec-0002"]
              }
            ],
