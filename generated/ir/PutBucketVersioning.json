  "quirks": [
              {
                "id": "q-ver-0002",
                "kind": "lenient_unknown_elements",
                "target": "PutBucketVersioning",
                "summary": "An element the decoder does not know is skipped and the rest of the document is stored, because a versioning document that stopped parsing would be degraded to no configuration and turn version retention off without any visible failure.",
                "evidence": [
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/613",
                                "summary": "Upstream established that S3 accepts request documents carrying elements it does not define rather than refusing them, and a stricter parser broke clients that sent them."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/userguide/Versioning.html",
                                "summary": "The versioning guide describes suspension as retaining existing versions, which is what makes a silently unconfigured document a data-retention change rather than a feature toggle."
                              }
                            ],
                "cases": ["c-bucketconfig-0046"]
              },
              {
                "id": "q-ver-0003",
                "kind": "checksum_required",
                "target": "PutBucketVersioning",
                "summary": "The versioning write demands an integrity claim on the body, so a request with neither Content-MD5 nor an x-amz-checksum header is refused with 400 before the document is parsed.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutBucketVersioning.html",
                                "summary": "The request documents Content-MD5 as the base64 digest of the configuration, which the pinned model spells as a request checksum requirement the lowering does not read."
                              }
                            ],
                "cases": ["c-bucketconfig-0035", "c-bucketconfig-0001"]
              },
              {
                "id": "q-ver-0004",
                "kind": "element_name",
                "target": "VersioningConfiguration.MFADelete",
                "summary": "The member the model calls MFADelete is spelled MfaDelete on the wire, and the pinned model gives the read and the write the same spelling, so no alternate-name rule is needed for it here.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutBucketVersioning.html",
                                "summary": "The documented request syntax spells the multi-factor delete element MfaDelete, and the read reference beside it spells the same element the same way."
                              }
                            ],
                "cases": ["c-bucketconfig-0003"]
              }
            ],
