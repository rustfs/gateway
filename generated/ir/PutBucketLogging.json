  "quirks": [
              {
                "id": "q-log-0002",
                "kind": "required_body",
                "target": "PutBucketLogging",
                "summary": "An empty BucketLoggingStatus document is the documented way to stop logging and is accepted rather than refused, because this subresource has no delete operation to say it any other way.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutBucketLogging.html",
                                "summary": "The request reference describes omitting the logging element as the way to disable logging on a bucket, and the pinned model declares no delete operation for the subresource."
                              }
                            ],
                "cases": ["c-bucketconfig-0047"]
              },
              {
                "id": "q-acl-0003",
                "kind": "xml_attribute",
                "target": "Grantee.Type",
                "summary": "The grantee discriminator is an XML attribute of <Grantee> and not a child element, which makes it the one member of the supported surface that cannot be written by the ordinary element emitter; the frozen IR reserves xml.attributes for it and the generated encoder writes it from there rather than from a branch in the codec.",
                "evidence": [
                              {
                                "kind": "s3s-pr",
                                "ref": "https://github.com/s3s-project/s3s/pull/299",
                                "summary": "Upstream had to add XML attribute support to its serializer before ACL responses could carry the discriminator at all."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_Grantee.html",
                                "summary": "The Grantee reference documents Type as an attribute of the containing element rather than as a member element."
                              }
                            ],
                "cases": ["c-acl-0001", "c-acl-0002", "c-acl-0003", "c-acl-0004"]
              },
              {
                "id": "q-log-0003",
                "kind": "element_name",
                "target": "LoggingEnabled.TargetGrants",
                "summary": "The grant list is wrapped in a TargetGrants element whose entries are spelled Grant rather than TargetGrant, so a reader looking for the member name on the wire will not find it.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutBucketLogging.html",
                                "summary": "The documented request syntax shows Grant elements nested inside a TargetGrants wrapper, which is the wrapped shape rather than the flattened one the notification family uses."
                              }
                            ],
                "cases": ["c-bucketconfig-0009", "c-bucketconfig-0008"]
              },
              {
                "id": "q-acl-0004",
                "kind": "aws_deviation",
                "target": "Grantee.Type",
                "summary": "On the way in the discriminator is derived from whichever of ID, URI or EmailAddress the grantee carries, because the XML reader this project ships exposes no attributes at all; for every document AWS accepts the two agree, and a document whose attribute contradicts its members is read by its members.",
                "evidence": [
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/297",
                                "summary": "The same missing capability upstream hit from the writing side; here it is the reading side that has no attribute access."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_Grantee.html",
                                "summary": "Each documented Type value pairs with exactly one identifying member, which is what makes the member a sound discriminator."
                              }
                            ],
                "cases": ["c-acl-0005", "c-acl-0021", "c-acl-0022"]
              },
              {
                "id": "q-log-0004",
                "kind": "checksum_required",
                "target": "PutBucketLogging",
                "summary": "The logging write demands an integrity claim on the body, so a request with neither Content-MD5 nor an x-amz-checksum header is refused with 400 before the document is parsed.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutBucketLogging.html",
                                "summary": "The request documents Content-MD5 as the base64 digest of the configuration, which the pinned model spells as a request checksum requirement the lowering does not read."
                              }
                            ],
                "cases": ["c-bucketconfig-0037", "c-bucketconfig-0008"]
              }
            ],
