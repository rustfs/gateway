              },
              {
                "id": "q-timestamp-0005",
                "kind": "timestamp_format",
                "target": "PutObject.Expires",
                "summary": "The value must be round tripped as an opaque string, because stored values are frequently not parseable dates at all.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutObject.html",
                                "summary": "The SDKs added a separate string valued member for this header after non date values were observed in production data."
                              },
                              {
                                "kind": "observed",
                                "ref": "captures/put-object-expires-nondate.http",
                                "summary": "Recorded request where the header value is not a date, which a parsing implementation would reject or rewrite."
                              }
                            ],
                "cases": ["c-object-0006"]
              },
              {
                "id": "q-sse-0010",
                "kind": "secret_hygiene",
                "target": "PutObject",
                "summary": "The customer key is never echoed back and never logged, while the algorithm and key digest must be echoed; customer keys over a plaintext connection are refused.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/dev/ServerSideEncryptionCustomerKeys.html",
                                "summary": "Requires a secure connection for customer provided keys and describes which of the three headers are echoed in the response."
                              }
                            ],
                "cases": ["c-ssec-0001", "c-ssec-0002"]
              },
              {
                "id": "q-mpu-upload-id-0037",
                "kind": "capability_token",
                "target": "UploadPart.UploadId",
                "summary": "An upload id is a server-minted capability, not a name the caller chose: it is resolved against the bucket and key of the request before anything is written, an unknown id answers the not-found code, and one belonging to another resource is refused rather than honoured.",
                "evidence": [
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/51",
                                "summary": "Upstream accepted any upload id without checking what it belonged to, so knowing an id was enough to act on somebody else's upload."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_UploadPart.html",
                                "summary": "The request is documented as naming a bucket, a key and an upload id together, and the id is only meaningful for that pair."
                              }
                            ],
                "cases": [
                           "c-mpu-0028",
                           "c-mpu-0029",
                           "c-mpu-0030",
                           "c-mpu-0031",
                           "c-mpu-0032",
                           "c-mpu-0043",
                           "c-mpu-0047",
                           "c-mpu-0049",
                           "c-mpu-0050",
                           "c-mpu-0051",
                           "c-mpu-0052"
                         ]
              },
              {
                "id": "q-etag-form-0074",
                "kind": "wire_form",
                "target": "GetObject.IfMatch",
                "summary": "A conditional header carries one entity tag and is checked against that grammar before anything compares it, so an unterminated quote is a bad request rather than a tag whose first character is a quote, and two field lines joined by a comma are refused rather than reduced to whichever one arrived first.",
                "evidence": [
                              {
                                "kind": "rfc",
                                "ref": "https://www.rfc-editor.org/rfc/rfc9110#section-8.8.3",
                                "summary": "The entity-tag grammar requires a balanced pair of quotes around the opaque tag, so an unterminated value is not a tag at all."
                              },
                              {
                                "kind": "rfc",
                                "ref": "https://www.rfc-editor.org/rfc/rfc9110#section-5.3",
                                "summary": "Repeated field lines are one field whose value is the members joined by commas, which is a value the entity-tag grammar does not admit."
                              },
                              {
                                "kind": "s3s-pr",
                                "ref": "https://github.com/s3s-project/s3s/pull/37",
                                "summary": "Upstream change that typed a request header after unparsed values had been reaching code unable to handle them."
                              }
                            ],
                "cases": ["c-cond-0019", "c-cond-0028"]
              },
              {
                "id": "q-copy-source-split-0077",
                "kind": "wire_parse_order",
                "target": "CopyObject.CopySource",
                "summary": "The optional `?versionId=` suffix of the copy-source header is split off at the last question mark of the raw header value and only then is each half percent-decoded, so a key whose own bytes encode a question mark keeps it instead of being cut in two at a separator that was never sent.",
                "evidence": [
                              {
                                "kind": "s3s-pr",
                                "ref": "https://github.com/s3s-project/s3s/pull/462",
                                "summary": "Upstream change correcting a copy-source parser that decoded before splitting, so an encoded question mark inside a key was read as the start of the version suffix."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_CopyObject.html",
                                "summary": "The documented header carries a URL-encoded source path with an optional version suffix appended after it, which fixes which of the two operations has to happen first."
                              }
                            ],
                "cases": ["c-copy-0001", "c-copy-0003", "c-copy-0028"]
              },
              {
                "id": "q-copy-source-arn-0078",
                "kind": "wire_grammar_union",
                "target": "CopyObject.CopySource",
                "summary": "The copy-source header admits three grammars — a bucket-and-key path with an optional leading slash, an access point ARN, and an Outposts ARN — and a value matching none of them is refused with InvalidArgument rather than being demoted to a bucket name, because demoting it would silently address a bucket literally called `arn:aws:iam::...`.",
                "evidence": [
                              {
                                "kind": "s3s-pr",
                                "ref": "https://github.com/s3s-project/s3s/pull/527",
                                "summary": "Upstream change adding the two ARN spellings of the copy-source header to a parser that had only ever accepted the bucket-and-key path form."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_CopyObject.html",
                                "summary": "The documented header lists the access point and Outposts ARN spellings alongside the path spelling as alternative ways of naming one source object."
                              }
                            ],
                "cases": ["c-copy-0002", "c-copy-0004", "c-copy-0005", "c-copy-0024", "c-copy-0025"]
              },
              {
                "id": "q-copy-conditions-0081",
                "kind": "independent_conditions",
                "target": "CopyObject.CopySourceIfMatch",
                "summary": "The four `x-amz-copy-source-if-*` conditions are evaluated against the source object and the four unprefixed conditions against the destination, as two independent verdicts that are never merged, and a copy-source entity tag arrives unquoted from more than one SDK and is compared as an opaque tag rather than refused.",
                "evidence": [
                              {
                                "kind": "s3s-pr",
                                "ref": "https://github.com/s3s-project/s3s/pull/577",
                                "summary": "Upstream change adding the four copy-source conditional headers, which until then were decoded and never evaluated."
                              },
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/448",
                                "summary": "Report that widely used SDKs send the copy-source entity tag without its quotes, so a parser demanding them refuses ordinary traffic."
                              },
                              {
                                "kind": "rfc",
                                "ref": "https://www.rfc-editor.org/rfc/rfc9110#section-13.1",
                                "summary": "Defines the precondition fields and their evaluation against one selected representation, which is what makes two representations two independent evaluations."
                              }
                            ],
                "cases": ["c-copy-0017", "c-copy-0018", "c-copy-0031", "c-copy-0032", "c-copy-0033"]
              },
              {
                "id": "q-copy-error-after-200-0082",
                "kind": "error_after_200",
                "target": "CopyObject",
                "summary": "A copy that fails after the response head has been flushed answers with the success status and an `<Error>` document in the body, so the status alone never decides the outcome, and the response must not announce a trailer section it will not send.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_CopyObject.html",
                                "summary": "The documented behaviour is that a copy request can fail after the success status has been sent, with the failure carried in the body."
                              }
                            ],
                "cases": ["c-copy-0038"]
              },
              {
                "id": "q-copy-source-version-0083",
                "kind": "response_header_pair",
                "target": "CopyObject.CopySourceVersionId",
                "summary": "The version of the object that was read and the version of the object that was written travel in two different response headers, so an implementation that writes one value into both tells the client the copy it just made is the version it copied from.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_CopyObject.html",
                                "summary": "The documented response carries a copy-source version header and a version header as separate fields with separate meanings."
                              }
                            ],
                "cases": ["c-copy-0012"]
              },
              {
                "id": "q-copy-part-root-0084",
                "kind": "wire_root_name",
                "target": "UploadPartCopy",
                "summary": "The response root element of a part copy is the copy-part spelling rather than the operation name or the output shape name, so a generator that derived the root from either emits a document no SDK parses.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_UploadPartCopy.html#API_UploadPartCopy_ResponseSyntax",
                                "summary": "The documented response syntax shows a root element whose name matches neither the operation nor the structure the model names for the same body."
                              }
                            ],
                "cases": ["c-copy-0011"]
              },
              {
                "id": "q-copy-range-0085",
                "kind": "range_strictness",
                "target": "UploadPartCopy.CopySourceRange",
                "summary": "A copy-source range carries end minus start plus one bytes, and unlike a read range it is refused rather than clamped when it runs past the end of the source and refused outright when it names more than one span; a zero-byte source is a legal copy of nothing rather than an arithmetic edge that faults.",
                "evidence": [
                              {
                                "kind": "s3s-pr",
                                "ref": "https://github.com/s3s-project/s3s/pull/95",
                                "summary": "Upstream change correcting a copied range that declared and carried one byte fewer than the span the client asked for."
                              },
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/547",
                                "summary": "Report that copying a part from a zero-byte source object aborted the process instead of answering."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_UploadPartCopy.html",
                                "summary": "The documented copy-source range accepts one byte span and states the size bounds a part copy is held to."
                              }
                            ],
                "cases": ["c-copy-0013", "c-copy-0014", "c-copy-0015", "c-copy-0036", "c-copy-0037"]
              },
              {
                "id": "q-copy-source-date-0159",
                "kind": "header_tolerance",
                "target": "CopyObject.CopySourceIfUnmodifiedSince",
                "summary": "A copy-source date condition whose value is not a valid HTTP-date is ignored and the copy proceeds, on both copy-source date members of CopyObject and UploadPartCopy, while a readable one is still evaluated against the source object.",
                "evidence": [
                              {
                                "kind": "rfc",
                                "ref": "https://www.rfc-editor.org/rfc/rfc9110#section-13.1.3",
                                "summary": "A recipient ignores a modification-date condition it cannot parse, and the copy-source form is that condition applied to the source representation."
                              },
                              {
                                "kind": "rfc",
                                "ref": "https://www.rfc-editor.org/rfc/rfc9110#section-13.1.4",
                                "summary": "The same instruction to ignore an unreadable date is stated for the unmodified-since condition, which is the header minio-js 8 sends as the string Invalid Date."
