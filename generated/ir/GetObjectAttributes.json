  "quirks": [
              {
                "id": "q-sse-0010",
                "kind": "secret_hygiene",
                "target": "PutObject",
                "summary": "The customer key is never echoed back and never logged, while the algorithm and key digest must be echoed; customer keys over a plaintext connection are refused.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/dev/ServerSideEncryptionCustomerKeys.html",
                                "summary": "Requires a secure connection for customer provided keys and describes which of the three headers are echoed in the response."
                              }
                            ],
                "cases": ["c-ssec-0001", "c-ssec-0002"]
              },
              {
                "id": "q-mpu-part-0031",
                "kind": "flattened_list",
                "target": "ListParts.Parts",
                "summary": "Each part element repeats directly under the result root with no wrapper element around the sequence, so a wrapped rendering is a document every SDK reads as an empty page.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_ListParts.html",
                                "summary": "The documented response syntax repeats the part element as a direct child of the result root."
                              }
                            ],
                "cases": ["c-mpu-0010", "c-mpu-0048"]
              },
              {
                "id": "q-mpu-attributes-etag-0036",
                "kind": "etag_render",
                "target": "GetObjectAttributes.ETag",
                "summary": "The object attributes response is the one place an entity tag is written without the surrounding quotes; it is registered with the multipart family because the value it renders is the composite tag this family produces, while the operation itself lands with its own family.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_GetObjectAttributes.html",
                                "summary": "The documented response syntax shows the entity tag element without the quotes every other rendering of the same value carries."
                              },
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/632",
                                "summary": "Upstream held two conflicting quoting rules in two files, which is why the rendering context is part of the type here rather than a convention."
                              }
                            ],
                "cases": ["c-mpu-0002", "c-mpu-0018"]
              },
              {
                "id": "q-attributes-root-0087",
                "kind": "root_name",
                "target": "GetObjectAttributes",
                "summary": "The attributes response is rooted at an element named after the output shape itself, not after the `xmlName` the model gives that shape, so the generated root has to be stated here instead of derived.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_GetObjectAttributes.html",
                                "summary": "The documented response syntax opens with an element whose name is the output shape's own, which is not the name the pinned model's xmlName trait carries."
                              }
                            ],
                "cases": ["c-etag-0001"]
              }
            ],
