  "quirks": [
              {
                "id": "q-web-0002",
                "kind": "element_name",
                "target": "WebsiteConfiguration.RoutingRules",
                "summary": "The routing rules are wrapped: the list sits inside a RoutingRules element with one RoutingRule per entry, where every list in the notification family is flattened, and a flattened rendering here is a document SDKs read as having no rules.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutBucketWebsite.html",
                                "summary": "The documented request syntax nests each RoutingRule inside a single RoutingRules element rather than repeating rules directly under the configuration root."
                              }
                            ],
                "cases": ["c-bucketconfig-0013", "c-bucketconfig-0012"]
              },
              {
                "id": "q-web-0003",
                "kind": "exclusive_members",
                "target": "WebsiteConfiguration",
                "summary": "RedirectAllRequestsTo and the IndexDocument/ErrorDocument/RoutingRules group are alternatives: a document carrying both describes two different sites and there is no reading of it that serves anything predictable.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutBucketWebsite.html",
                                "summary": "The request reference presents the whole-site redirect and the document-serving members as two mutually exclusive ways to describe a website configuration."
                              }
                            ],
                "cases": ["c-bucketconfig-0049", "c-bucketconfig-0014"]
              },
              {
                "id": "q-web-0004",
                "kind": "required_body",
                "target": "RoutingRule.Redirect",
                "summary": "A routing rule must carry a Redirect: a rule that says what to match and not what to do is refused by the decoder as MalformedXML, because the member is required in the pinned model.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutBucketWebsite.html",
                                "summary": "The request reference declares the redirect element of a routing rule as required while its condition is optional."
                              }
                            ],
                "cases": ["c-bucketconfig-0050"]
              },
              {
                "id": "q-web-0006",
                "kind": "checksum_required",
                "target": "PutBucketWebsite",
                "summary": "The website write demands an integrity claim on the body, so a request with neither Content-MD5 nor an x-amz-checksum header is refused with 400 before the document is parsed.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutBucketWebsite.html",
                                "summary": "The request documents Content-MD5 as the base64 digest of the configuration, which the pinned model spells as a request checksum requirement the lowering does not read."
                              }
                            ],
                "cases": ["c-bucketconfig-0036", "c-bucketconfig-0012"]
              }
            ],
