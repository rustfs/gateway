                "id": "q-tag-md5-required-0092",
                "kind": "checksum_headers",
                "target": "PutBucketTagging",
                "summary": "The tagging writes are in the httpChecksumRequired operation set: a PUT with neither Content-MD5 nor an x-amz-checksum-* header is refused with 400 InvalidRequest before the document is read.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutBucketTagging.html",
