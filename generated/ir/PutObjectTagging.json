                              }
                            ],
                "cases": ["c-tagging-0008", "c-tagging-0009"]
              },
              {
                "id": "q-tag-limits-0094",
                "kind": "bounded_input",
                "target": "PutBucketTagging",
                "summary": "A tag set is bounded by scope — ten tags on an object, fifty on a bucket — and by shape: keys up to 128 characters, values up to 256, characters limited to letters, numbers, space and +-=._:/@, keys unique; every violation is a 400 InvalidTag.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/userguide/object-tagging.html",
                                "summary": "The user guide bounds an object at ten tags with 128-character keys and 256-character values drawn from the documented character set."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/awsaccountbilling/latest/aboutv2/allocation-tag-restrictions.html",
