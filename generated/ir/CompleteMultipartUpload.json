  "quirks": [
              {
                "id": "q-checksum-0006",
                "kind": "checksum_headers",
                "target": "PutObject",
                "summary": "The eleven separate checksum members collapse into one packed spec, and more than one checksum header on a request is a hard error rather than a merge.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutObject.html",
                                "summary": "Only one checksum algorithm header is accepted per request and the value is base64 encoded."
                              },
                              {
                                "kind": "capture",
                                "ref": "captures/put-object-two-checksums.http",
                                "summary": "Recorded rejection when two different checksum headers are sent together."
                              }
                            ],
                "cases": ["c-checksum-0001", "c-checksum-0002"]
              },
              {
                "id": "q-sse-0010",
                "kind": "secret_hygiene",
                "target": "PutObject",
                "summary": "The customer key is never echoed back and never logged, while the algorithm and key digest must be echoed; customer keys over a plaintext connection are refused.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/dev/ServerSideEncryptionCustomerKeys.html",
                                "summary": "Requires a secure connection for customer provided keys and describes which of the three headers are echoed in the response."
                              }
                            ],
                "cases": ["c-ssec-0001", "c-ssec-0002"]
              },
              {
                "id": "q-timestamp-0012",
                "kind": "structured_header",
                "target": "PutObject.Expiration",
                "summary": "The expiration header is a structured value whose quoted parameter embeds an HTTP date, so it must not be modelled as a timestamp.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutObject.html#API_PutObject_ResponseSyntax",
                                "summary": "Shows the header as a pair of quoted parameters, one of which contains a date."
                              }
                            ],
                "cases": ["c-expiration-0001"]
              },
              {
                "id": "q-mpu-etag-0028",
                "kind": "etag_composite",
                "target": "CompleteMultipartUpload.ETag",
                "summary": "The entity tag of a completed upload is a digest over the concatenated raw part digests followed by a hyphen and the part count, never a digest of the assembled object, and an empty part list is refused rather than digested.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/userguide/checking-object-integrity.html",
                                "summary": "Describes the multipart entity tag as a digest of the part digests carrying a part-count suffix, distinguishing it from a whole-object digest."
                              },
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/550",
                                "summary": "Upstream computed the tag over the assembled object, so every client that verified integrity concluded the object was corrupt."
                              },
                              {
                                "kind": "s3s-pr",
                                "ref": "https://github.com/s3s-project/s3s/pull/556",
                                "summary": "The fix derives the tag from the part digests and refuses an empty part list with a dedicated code."
                              }
                            ],
                "cases": ["c-mpu-0002", "c-mpu-0003", "c-mpu-0019"]
              },
              {
                "id": "q-mpu-request-root-0030",
                "kind": "wire_root_name",
                "target": "CompleteMultipartUpload.MultipartUpload",
                "summary": "The accepted request root is the completion verb while the model shape is the completed-participle spelling, and the model carries the wire name on the member rather than on the shape, so the payload decoder cannot take the shape name.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_CompleteMultipartUpload.html",
                                "summary": "The documented request syntax names a root element that differs from the structure name the model uses for the same body."
                              },
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/2",
