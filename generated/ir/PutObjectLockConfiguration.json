  "quirk_refs": ["q-lock-0006", "q-lock-0007", "q-lock-0008", "q-lock-0009", "q-lock-0010", "q-lock-0014"],
  "quirks": [
              {
                "id": "q-lock-0006",
                "kind": "checksum_required",
                "target": "PutObjectLockConfiguration",
                "summary": "All three writes in this family demand an integrity claim on the body, so a request with neither Content-MD5 nor an x-amz-checksum header is refused with 400 before the document is parsed.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutObjectLockConfiguration.html",
                                "summary": "The request documents Content-MD5 as required for the operation, which the pinned model spells as a request checksum requirement shared by the retention and legal-hold writes."
                              }
                            ],
                "cases": ["c-lock-0014"]
              },
              {
                "id": "q-lock-0007",
                "kind": "required_body",
                "target": "PutObjectRetention",
                "summary": "The payload member of all three writes is promoted to required, so an empty body is refused as 400 MalformedXML rather than read as a defaulted document — a silently-accepted empty body is how a legal hold gets set to a value nobody sent.",
                "evidence": [
                              {
                                "kind": "s3s-pr",
                                "ref": "https://github.com/s3s-project/s3s/pull/377",
                                "summary": "Upstream accepted an empty body on the retention and legal-hold writes without an error, and the fix pins the empty-required-XML answer to 400 MalformedXML."
                              }
                            ],
                "cases": ["c-lock-0015"]
              },
              {
                "id": "q-lock-0008",
                "kind": "closed_value_set",
                "target": "DefaultRetention.Mode",
                "summary": "A retention mode outside the documented two-value set — GOVERNANCE, COMPLIANCE, exactly in that spelling — is refused as MalformedXML: the values are case-sensitive, so a lowercase governance is out of the set, and a mode nothing can enforce is a lock that protects nothing.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_ObjectLockRetention.html",
                                "summary": "The Mode member documents the closed value set GOVERNANCE and COMPLIANCE, in upper case, for both the object retention document and the bucket default."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/ErrorResponses.html",
                                "summary": "MalformedXML is documented as the answer for a request body that does not validate against the published schema, which is what an out-of-set enum value is."
                              }
                            ],
                "cases": ["c-lock-0016", "c-lock-0017", "c-lock-0008"]
              },
              {
                "id": "q-lock-0009",
                "kind": "closed_value_set",
                "target": "ObjectLockConfiguration.ObjectLockEnabled",
                "summary": "ObjectLockEnabled has exactly one documented value, Enabled: AWS defines no Disabled spelling because object lock, once on, cannot be turned off, so any other value is refused as MalformedXML rather than read as an off switch.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_ObjectLockConfiguration.html",
                                "summary": "The ObjectLockEnabled member documents Enabled as its only valid value."
                              }
                            ],
                "cases": ["c-lock-0018"]
              },
              {
                "id": "q-lock-0010",
                "kind": "value_constraint",
                "target": "DefaultRetention",
                "summary": "A DefaultRetention must carry a mode and exactly one period: Days and Years together are refused as MalformedXML, a mode with neither period likewise, and a period under one — Days 0, Years -1 — is refused as InvalidArgument.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutObjectLockConfiguration.html",
                                "summary": "The operation documents that DefaultRetention requires both a mode and a period, and that Days and Years cannot be specified at the same time."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_DefaultRetention.html",
                                "summary": "Both period members document a minimum value of one."
                              }
                            ],
                "cases": ["c-lock-0019", "c-lock-0020", "c-lock-0021"]
              },
              {
                "id": "q-lock-0014",
                "kind": "lenient_unknown_elements",
                "target": "PutObjectLockConfiguration",
                "summary": "Unknown elements inside a lock document are skipped rather than refused, on all three writes: a stored WORM configuration is re-parsed by every future release, and a decoder that got stricter would downgrade the document to none — silently unlocking data — which is a worse failure than tolerating an element AWS added.",
                "evidence": [
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/613",
                                "summary": "AWS ignores unknown elements in request XML, and upstream had to relax its decoder to match after strict parsing broke real clients."
                              },
                              {
                                "kind": "s3s-pr",
                                "ref": "https://github.com/s3s-project/s3s/pull/617",
                                "summary": "The upstream fix that makes unknown request elements a skip rather than an error, which is the behaviour this decoder generates by construction."
                              }
                            ],
                "cases": ["c-lock-0010"]
              }
            ],
