  "quirk_refs": ["q-cors-0003", "q-cors-0004", "q-cors-0005", "q-cors-0007", "q-cors-0008"],
  "quirks": [
              {
                "id": "q-cors-0003",
                "kind": "flattened_list",
                "target": "CORSRule",
                "summary": "Inside one rule the four list members repeat as singular AllowedMethod, AllowedOrigin, AllowedHeader and ExposeHeader elements with no wrapper, so a round trip must preserve repeated siblings.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_CORSRule.html",
                                "summary": "Each list member of the rule is documented with a singular element name that repeats once per value, rather than a plural wrapper element."
                              }
                            ],
                "cases": ["c-cors-0003", "c-cors-0005"]
              },
              {
                "id": "q-cors-0004",
                "kind": "closed_value_set",
                "target": "CORSRule.AllowedMethods",
                "summary": "AllowedMethod admits exactly GET, PUT, POST, DELETE and HEAD; another method is refused rather than stored.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_CORSRule.html",
                                "summary": "The AllowedMethods member documents the five accepted HTTP method names as its whole value set."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/userguide/ManageCorsUsing.html",
                                "summary": "The CORS configuration guide states that an unsupported method in a rule makes the whole configuration invalid and names the supported five."
                              }
                            ],
                "cases": ["c-cors-0005", "c-cors-0016"]
              },
              {
                "id": "q-cors-0005",
                "kind": "wildcard_syntax",
                "target": "CORSRule.AllowedOrigins",
                "summary": "An allowed origin may carry at most one asterisk wildcard; a second is refused rather than stored.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/userguide/ManageCorsUsing.html",
                                "summary": "The guide permits one wildcard character in an AllowedOrigin or AllowedHeader value and rules wildcards out of ExposeHeader values."
                              }
                            ],
                "cases": ["c-cors-0006", "c-cors-0007", "c-cors-0018"]
              },
              {
                "id": "q-cors-0007",
                "kind": "lenient_unknown_elements",
                "target": "PutBucketCors.CORSConfiguration",
                "summary": "Unknown elements inside the request document are skipped rather than refused, because a stored configuration parsed more strictly on the next release silently turns off cross-origin access with only a browser-side symptom.",
                "evidence": [
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/613",
                                "summary": "AWS ignores unknown elements in request XML, and upstream had to relax its decoder to match after strict parsing broke real clients."
                              },
                              {
                                "kind": "s3s-pr",
                                "ref": "https://github.com/s3s-project/s3s/pull/617",
                                "summary": "The upstream fix that makes unknown request elements a skip rather than an error, which is the behaviour this decoder generates by construction."
                              }
                            ],
                "cases": ["c-cors-0022"]
              },
              {
                "id": "q-cors-0008",
                "kind": "checksum_required",
                "target": "PutBucketCors",
                "summary": "The write demands an integrity claim on the body, so a request with neither Content-MD5 nor an x-amz-checksum header is refused with 400 before the document is parsed.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutBucketCors.html",
                                "summary": "The request syntax documents Content-MD5 as required for this operation, which the model spells as a request checksum requirement."
                              }
                            ],
                "cases": ["c-cors-0014"]
              }
            ],
