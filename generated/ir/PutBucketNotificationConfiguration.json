  "quirks": [
              {
                "id": "q-ntf-0002",
                "kind": "flattened_list",
                "target": "NotificationConfiguration",
                "summary": "All three destination lists and the Event list inside each of them repeat as sibling elements directly under their parent with no wrapper, which is the opposite of the website family's wrapped routing rules.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutBucketNotificationConfiguration.html",
                                "summary": "The documented request syntax shows the topic, queue and function configurations as direct children of the root with no intermediate element, and the event names likewise inside each of them."
                              }
                            ],
                "cases": ["c-bucketconfig-0011", "c-bucketconfig-0010"]
              },
              {
                "id": "q-ntf-0003",
                "kind": "checksum_required",
                "target": "PutBucketNotificationConfiguration",
                "summary": "The v2 notification write is the second of two writes in this band that carry no integrity requirement, so a body with neither Content-MD5 nor an x-amz-checksum header is accepted.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutBucketNotificationConfiguration.html",
                                "summary": "The request reference for the current notification write lists no Content-MD5 header, unlike the retired operation it replaced and unlike the six other writes in this band."
                              }
                            ],
                "cases": ["c-bucketconfig-0010", "c-bucketconfig-0042"]
              },
              {
                "id": "q-ntf-0004",
                "kind": "element_name",
                "target": "NotificationConfiguration.LambdaFunctionConfigurations",
                "summary": "Five members of this document are spelled differently on the wire than in the model: the function configuration is CloudFunctionConfiguration, its ARN is CloudFunction, the queue and topic ARNs are Queue and Topic, and the key filter is S3Key.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutBucketNotificationConfiguration.html",
                                "summary": "The documented request syntax uses the historical element names throughout, which the pinned model records as xmlName overrides on those five members."
                              }
                            ],
                "cases": ["c-bucketconfig-0011"]
              },
              {
                "id": "q-ntf-0005",
                "kind": "lenient_enum",
                "target": "NotificationConfiguration",
                "summary": "An event name this build has no constant for is stored and echoed as sent rather than refused, because AWS adds event types continuously and a gateway that refused unknown ones would reject configurations AWS accepts until it was rebuilt.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/userguide/notification-how-to-event-types-and-destinations.html",
                                "summary": "The event-type list has grown repeatedly since the operation was introduced, which is what makes a closed set here a promise that expires."
                              }
                            ],
                "cases": ["c-bucketconfig-0048"]
              }
            ],
  "ext_points": []
