  "quirks": [
              {
                "id": "q-delete-0026",
                "kind": "idempotent_delete",
                "target": "DeleteObject",
                "summary": "Deleting a key that does not exist is a success and answers the same empty 204 as deleting one that does; a not-found status here breaks every retrying client.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_DeleteObject.html",
                                "summary": "The documented response is the same whether or not the key was present."
                              },
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/455",
                                "summary": "Upstream answered not-found for an absent key, which turned a retried delete into a client-visible failure."
                              }
                            ],
                "cases": ["c-object-0003"]
              }
