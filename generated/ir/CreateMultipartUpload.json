              {
                "id": "q-mpu-metadata-0039",
                "kind": "deferred_metadata",
                "target": "CreateMultipartUpload",
                "summary": "User metadata, content type, storage class and the encryption settings are carried on the initiating request alone and take effect on the assembled object; a part upload carries none of them, so losing them at initiation loses them permanently.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_CreateMultipartUpload.html",
                                "summary": "The object metadata headers are documented on the initiating request and not on the part request."
                              },
                              {
                                "kind": "s3s-pr",
                                "ref": "https://github.com/s3s-project/s3s/pull/129",
                                "summary": "Upstream dropped the metadata supplied at initiation, so it was absent from the object after completion."
                              }
                            ],
                "cases": ["c-mpu-0006", "c-mpu-0007"]
              }
