  "quirks": [
              {
                "id": "q-timestamp-0005",
                "kind": "timestamp_format",
                "target": "PutObject.Expires",
                "summary": "The value must be round tripped as an opaque string, because stored values are frequently not parseable dates at all.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutObject.html",
                                "summary": "The SDKs added a separate string valued member for this header after non date values were observed in production data."
                              },
                              {
                                "kind": "observed",
                                "ref": "captures/put-object-expires-nondate.http",
                                "summary": "Recorded request where the header value is not a date, which a parsing implementation would reject or rewrite."
                              }
                            ],
                "cases": ["c-object-0006"]
              },
              {
                "id": "q-content-0008",
                "kind": "default_value",
                "target": "PutObject.ContentType",
                "summary": "The default media type is the S3 specific binary form, not the IANA registered octet stream spelling.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutObject.html",
                                "summary": "Documents the S3 specific default media type applied when the request omits the header."
                              }
                            ],
                "cases": ["c-object-0001", "c-object-0006"]
              },
              {
                "id": "q-meta-0009",
                "kind": "prefix_headers",
                "target": "PutObject.Metadata",
                "summary": "User metadata keys are lowercased on return, non ASCII values use encoded word syntax, and the combined size is capped.",
                "evidence": [
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/405",
                                "summary": "Upstream did not encode non ASCII metadata values, producing headers that violate the field value grammar."
                              },
                              {
                                "kind": "rfc",
                                "ref": "https://www.rfc-editor.org/rfc/rfc2047",
                                "summary": "Defines the encoded word syntax used to carry non ASCII text in header field values."
                              }
                            ],
                "cases": ["c-meta-0001", "c-meta-0002"]
              },
              {
                "id": "q-sse-0010",
                "kind": "secret_hygiene",
                "target": "PutObject",
                "summary": "The customer key is never echoed back and never logged, while the algorithm and key digest must be echoed; customer keys over a plaintext connection are refused.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/dev/ServerSideEncryptionCustomerKeys.html",
                                "summary": "Requires a secure connection for customer provided keys and describes which of the three headers are echoed in the response."
                              }
                            ],
                "cases": ["c-ssec-0001", "c-ssec-0002"]
              },
              {
                "id": "q-timestamp-0011",
                "kind": "timestamp_format",
                "target": "PutObject.ObjectLockRetainUntilDate",
                "summary": "This is the only request header carrying the extended date time format instead of the HTTP date format.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutObject.html",
                                "summary": "Specifies the retain until date header in the extended date time format while every other date header uses the HTTP date format."
                              }
                            ],
                "cases": ["c-objectlock-0001"]
              },
              {
                "id": "q-mpu-root-0029",
                "kind": "wire_root_name",
                "target": "CreateMultipartUpload",
                "summary": "The response root element is the initiate spelling rather than the operation or shape name, so a generator that derived the root from either would produce a document no client parses.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_CreateMultipartUpload.html",
                                "summary": "The documented response syntax shows a root element whose name does not match the operation name."
                              }
                            ],
                "cases": ["c-mpu-0004"]
              },
              {
                "id": "q-mpu-upload-id-0037",
                "kind": "capability_token",
                "target": "UploadPart.UploadId",
                "summary": "An upload id is a server-minted capability, not a name the caller chose: it is resolved against the bucket and key of the request before anything is written, an unknown id answers the not-found code, and one belonging to another resource is refused rather than honoured.",
                "evidence": [
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/51",
                                "summary": "Upstream accepted any upload id without checking what it belonged to, so knowing an id was enough to act on somebody else's upload."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_UploadPart.html",
                                "summary": "The request is documented as naming a bucket, a key and an upload id together, and the id is only meaningful for that pair."
                              }
                            ],
                "cases": [
