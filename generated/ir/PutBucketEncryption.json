  "quirks": [
              {
                "id": "q-enc-0004",
                "kind": "checksum_required",
                "target": "PutBucketEncryption",
                "summary": "The write demands an integrity claim on the body, so a request with neither Content-MD5 nor an x-amz-checksum header is refused with 400 before the document is parsed.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutBucketEncryption.html",
                                "summary": "The request documents Content-MD5 as the base64 digest of the configuration, which the pinned model spells as a request checksum requirement."
                              }
                            ],
                "cases": ["c-encryption-0014", "c-encryption-0007"]
              },
              {
                "id": "q-enc-0005",
                "kind": "value_constraint",
                "target": "ServerSideEncryptionByDefault.KMSMasterKeyID",
                "summary": "A KMSMasterKeyID is allowed if and only if SSEAlgorithm is aws:kms or aws:kms:dsse; a document naming a key id beside AES256 or aws:fsx is refused with 400 InvalidArgument.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_ServerSideEncryptionByDefault.html",
                                "summary": "The KMSMasterKeyID member is documented as allowed if and only if SSEAlgorithm is set to aws:kms or aws:kms:dsse."
                              }
                            ],
                "cases": ["c-encryption-0017", "c-encryption-0024"]
              },
              {
                "id": "q-enc-0006",
                "kind": "lenient_unknown_elements",
                "target": "PutBucketEncryption",
                "summary": "Unknown elements inside the request document are skipped rather than refused, because a stored configuration parsed more strictly on the next release silently turns default encryption off and nothing visible fails until objects land unencrypted.",
                "evidence": [
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/613",
                                "summary": "AWS ignores unknown elements in request XML, and upstream had to relax its decoder to match after strict parsing broke real clients."
                              },
                              {
                                "kind": "s3s-pr",
                                "ref": "https://github.com/s3s-project/s3s/pull/617",
                                "summary": "The upstream fix that makes unknown request elements a skip rather than an error, which is the behaviour this decoder generates by construction."
                              }
                            ],
                "cases": ["c-encryption-0009"]
              },
              {
                "id": "q-enc-0007",
                "kind": "closed_value_set",
                "target": "ServerSideEncryptionByDefault.SSEAlgorithm",
                "summary": "A write naming an SSEAlgorithm outside the documented set — AES256, aws:fsx, aws:kms, aws:kms:dsse — is refused as MalformedXML: a default-encryption algorithm nothing can apply is a configuration that silently protects nothing.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_ServerSideEncryptionByDefault.html",
                                "summary": "The SSEAlgorithm member documents the closed value set AES256, aws:fsx, aws:kms and aws:kms:dsse, and is the required member of the default-encryption action."
                              },
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/ErrorResponses.html",
                                "summary": "MalformedXML is documented as the answer for a request body that does not validate against the published schema, which is what an out-of-set enum value is."
                              }
                            ],
                "cases": ["c-encryption-0018", "c-encryption-0004", "c-encryption-0005"]
              },
              {
                "id": "q-enc-0008",
                "kind": "unbounded_list",
                "target": "ServerSideEncryptionConfiguration.Rules",
                "summary": "Neither the pinned model nor the API reference bounds the rule list or names a single-rule requirement, so a multi-rule document is stored and echoed as sent rather than refused — which rule an object write applies is the encryption path's question, not the codec's.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_GetBucketEncryption.html",
                                "summary": "The response documents Rule as an array of ServerSideEncryptionRule with repeated elements and states no count limit."
                              }
                            ],
                "cases": ["c-encryption-0010"]
              },
              {
                "id": "q-enc-0009",
                "kind": "secret_hygiene",
                "target": "ServerSideEncryptionByDefault.KMSMasterKeyID",
                "summary": "The model marks the KMS key id sensitive: the stored document echoes it on the read — that is the documented GET response — but a refusal message never carries it, so a rejected write cannot leak a key id into an error body or a log line.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_GetBucketEncryption.html",
                                "summary": "The sample response shows the configured KMS key identifier echoed inside the returned document, which pins the echo as read behaviour rather than error behaviour."
                              },
                              {
                                "kind": "s3s-pr",
                                "ref": "https://github.com/s3s-project/s3s/pull/319",
                                "summary": "Upstream's secret-handling fixes are the record of how easily key material reaches unintended surfaces once it is carried as a plain string."
                              }
                            ],
                "cases": ["c-encryption-0017", "c-encryption-0003"]
              }
            ],
