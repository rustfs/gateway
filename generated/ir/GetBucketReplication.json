  "quirks": [
              {
                "id": "q-repl-0001",
                "kind": "not_configured_error",
                "target": "GetBucketReplication",
                "summary": "A bucket that never had a replication document answers 404 with the operation-specific code ReplicationConfigurationNotFoundError — one of the few AWS codes whose literal ends in Error — not a generic not-found and not an empty 200.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/ErrorResponses.html",
                                "summary": "The replication-related error code list documents ReplicationConfigurationNotFoundError with HTTP status 404 for a bucket with no replication configuration."
                              },
                              {
                                "kind": "s3s-pr",
                                "ref": "https://github.com/s3s-project/s3s/pull/515",
                                "summary": "Upstream had to backfill missing error codes because clients branch on the specific code string, this family's included."
                              }
                            ],
                "cases": ["c-replication-0013", "c-replication-0012"]
              },
              {
                "id": "q-repl-0002",
                "kind": "flattened_list",
                "target": "ReplicationConfiguration.Rules",
                "summary": "The rules repeat as sibling Rule elements directly under the ReplicationConfiguration root; a Rules wrapper element would make every SDK read zero rules and conclude the bucket replicates nothing.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_GetBucketReplication.html",
                                "summary": "The documented response syntax shows Rule elements as direct children of the ReplicationConfiguration root with no intermediate wrapper."
                              },
                              {
                                "kind": "s3s-issue",
                                "ref": "https://github.com/s3s-project/s3s/issues/264",
                                "summary": "Upstream shipped response roots without the S3 xmlns and strict clients refused them, which is why the root and its namespace are pinned byte for byte."
                              }
                            ],
                "cases": ["c-replication-0002", "c-replication-0003", "c-replication-0009", "c-replication-0010"]
              },
              {
                "id": "q-repl-0011",
                "kind": "arn_valued_member",
                "target": "Destination.Bucket",
                "summary": "The destination Bucket member is typed as a bucket name in the model but carries an ARN on the wire — arn:aws:s3:::bucket — so it is decoded as a plain string and neither the bucket-name grammar nor any ARN grammar is enforced on it: the model's type is unenforceable and a stricter grammar would be this project's invention.",
                "evidence": [
                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_Destination.html",
                                "summary": "The Bucket member is documented as the Amazon Resource Name of the destination bucket, a value the S3 bucket-name grammar itself would refuse."
                              }
                            ],
                "cases": ["c-replication-0006", "c-replication-0007"]
              },
              {
                "id": "q-repl-0014",
