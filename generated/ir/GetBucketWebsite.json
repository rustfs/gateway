                              {
                                "kind": "aws-doc",
                                "ref": "https://docs.aws.amazon.com/AmazonS3/latest/API/API_PutBucketWebsite.html",
                                "summary": "The documented request syntax nests each RoutingRule inside a single RoutingRules element rather than repeating rules directly under the configuration root."
                              }
                            ],
